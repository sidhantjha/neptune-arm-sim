
<?xml version="1.0"?>
<robot name="neptune_2dof_arm">

  <!-- Materials -->
  <material name="gray">
    <color rgba="0.35 0.35 0.40 1"/>
  </material>
  <material name="blue">
    <color rgba="0.15 0.40 0.95 1"/>
  </material>
  <material name="teal">
    <color rgba="0.05 0.75 0.65 1"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.55 0.05 1"/>
  </material>

  <!-- Fixed base -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0.30"/>
      <geometry>
        <box size="0.12 0.12 0.60"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.30"/>
      <geometry>
        <box size="0.12 0.12 0.60"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.30"/>
      <mass value="1.0"/>
      <inertia ixx="0.0312" ixy="0" ixz="0"
               iyy="0.0312" iyz="0" izz="0.0024"/>
    </inertial>
  </link>

  <!-- First link: 30 cm -->
  <link name="link1">
    <visual>
      <origin xyz="0.15 0 0"/>
      <geometry>
        <box size="0.30 0.04 0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0.15 0 0"/>
      <geometry>
        <box size="0.30 0.04 0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.15 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000107" ixy="0" ixz="0"
               iyy="0.003053" iyz="0" izz="0.003053"/>
    </inertial>
  </link>

  <!-- Second link: 25 cm -->
  <link name="link2">
    <visual>
      <origin xyz="0.125 0 0"/>
      <geometry>
        <box size="0.25 0.04 0.04"/>
      </geometry>
      <material name="teal"/>
    </visual>

    <!-- Orange marker at the end effector -->
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0.125 0 0"/>
      <geometry>
        <box size="0.25 0.04 0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.001603" iyz="0" izz="0.001603"/>
    </inertial>
  </link>

  <!-- Shoulder joint -->
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="link1"/>

    <origin xyz="0 0 0.65"/>
    <axis xyz="0 -1 0"/>

    <limit lower="-2.6" upper="2.6"
           effort="20" velocity="2.0"/>
    <dynamics damping="0.05"/>
  </joint>

  <!-- Elbow joint -->
  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>

    <origin xyz="0.30 0 0"/>
    <axis xyz="0 -1 0"/>

    <limit lower="-2.6" upper="2.6"
           effort="20" velocity="2.0"/>
    <dynamics damping="0.05"/>
  </joint>


  <!-- ====================================== -->
  <!-- M3: PARALLEL-JAW GRIPPER               -->
  <!-- ====================================== -->

  <!-- Gripper palm mounted at Link 2 tip -->
  <link name="gripper_palm">
    <visual>
      <geometry>
        <box size="0.04 0.07 0.035"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.04 0.07 0.035"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.10"/>
      <inertia
        ixx="0.000055" ixy="0" ixz="0"
        iyy="0.000020" iyz="0"
        izz="0.000055"/>
    </inertial>
  </link>

  <joint name="gripper_mount" type="fixed">
    <parent link="link2"/>
    <child link="gripper_palm"/>
    <origin xyz="0.27 0 0"/>
  </joint>


  <!-- ====================================== -->
  <!-- LEFT FINGER                            -->
  <!-- ====================================== -->

  <link name="left_finger">
    <visual>
      <origin xyz="0.055 0 0"/>
      <geometry>
        <box size="0.095 0.014 0.026"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0.055 0 0"/>
      <geometry>
        <box size="0.095 0.014 0.026"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.055 0 0"/>
      <mass value="0.035"/>
      <inertia
        ixx="0.00000254" ixy="0" ixz="0"
        iyy="0.00002830" iyz="0"
        izz="0.00002690"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_palm"/>
    <child link="left_finger"/>

    <origin xyz="0.02 0.021 0"/>
    <axis xyz="0 1 0"/>

    <limit lower="0" upper="0.035"
           effort="30" velocity="0.10"/>
    <dynamics damping="0.5"/>
  </joint>


  <!-- ====================================== -->
  <!-- RIGHT FINGER                           -->
  <!-- ====================================== -->

  <link name="right_finger">
    <visual>
      <origin xyz="0.055 0 0"/>
      <geometry>
        <box size="0.095 0.014 0.026"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0.055 0 0"/>
      <geometry>
        <box size="0.095 0.014 0.026"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.055 0 0"/>
      <mass value="0.035"/>
      <inertia
        ixx="0.00000254" ixy="0" ixz="0"
        iyy="0.00002830" iyz="0"
        izz="0.00002690"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_palm"/>
    <child link="right_finger"/>

    <origin xyz="0.02 -0.021 0"/>
    <axis xyz="0 -1 0"/>

    <limit lower="0" upper="0.035"
           effort="30" velocity="0.10"/>
    <dynamics damping="0.5"/>
  </joint>


</robot>
